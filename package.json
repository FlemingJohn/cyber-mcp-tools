{
  "name": "cyber-mcp-tools",
  "version": "1.0.0",
  "description": "MCP server for the MITRE ATT&CK knowledge base",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cyber-mcp-tools": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build:defend": "tsx src/defend/build/buildDefendData.ts",
    "build:attack": "tsx src/attack/build/buildAttackData.ts",
    "build:data": "npm run build:attack && npm run build:defend && npm run build:figures",
    "inspect": "tsx src/inspect/runInspection.ts",
    "inspect:ui": "npx @modelcontextprotocol/inspector node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json && tsc -p web/tsconfig.json",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "build:figures": "tsx src/figures/buildFigures.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "mcp-handler": "^2.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "data",
    "LICENSE",
    "NOTICE",
    "README.md"
  ]
}
